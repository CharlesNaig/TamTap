# TAMTAP Environment Configuration
# Copy this file to .env and update values as needed

# MongoDB Configuration
# PRIMARY: Local MongoDB on Raspberry Pi (fast writes)
MONGODB_URI=mongodb://user:password@localhost:27017/
# REMOTE: Cloud MongoDB for backup (async sync, leave empty to disable)
MONGODB_REMOTE_URI=mongodb://user:password@cloud-server:27017/
MONGODB_NAME=tamtap

# API Server Configuration
API_SERVER_PORT=80
API_SERVER_HOST=0.0.0.0

# API URL (for hardware to call)
TAMTAP_API_URL=http://localhost:80

# Session Secret (change this in production!)
SESSION_SECRET=tamtap-session-Secret

# Hardware API Key (shared between Pi and server, prevents forged attendance)
HARDWARE_SECRET=tamtap-hw-
