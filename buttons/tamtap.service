[Unit]
Description=TAMTAP NFC Hardware Service
Documentation=https://github.com/CharlesNaig/TamTap
After=network.target tamtap-server.service
Wants=tamtap-server.service

[Service]
Type=simple
ExecStart=/bin/bash /home/charles/TamTap/startup.sh
Restart=always
RestartSec=5
User=root
Environment=PYTHONUNBUFFERED=1

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tamtap

[Install]
WantedBy=multi-user.target
