{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd software && npm ci --omit=dev",
  "builds": [
    {
      "src": "software/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "software/public/**",
          "assets/**",
          "database/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/software/server.js"
    }
  ]
}
